<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dog">

  <!-- ===================== 全局参数 ===================== -->
  <xacro:property name="body_length"  value="0.30"/>
  <xacro:property name="body_width"   value="0.16"/>
  <xacro:property name="body_height"  value="0.05"/>

  <xacro:property name="thigh_length" value="0.10"/>
  <xacro:property name="calf_length"  value="0.10"/>
  <xacro:property name="leg_radius"   value="0.015"/>
  <xacro:property name="foot_radius"  value="0.02"/>

  <!-- 关节限位与力矩，教具阶段先用保守值 -->
  <xacro:property name="hip_limit"   value="0.8"/>
  <xacro:property name="thigh_limit" value="1.2"/>
  <xacro:property name="calf_limit"  value="1.5"/>
  <xacro:property name="joint_effort" value="10.0"/>
  <xacro:property name="joint_velocity" value="5.0"/>

  <!-- ===================== 材质 ===================== -->
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>

  <!-- ===================== 惯性宏 ===================== -->
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${mass*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass*(x*x+z*z)/12.0}" iyz="0.0"
               izz="${mass*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${mass*(3*radius*radius+length*length)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass*(3*radius*radius+length*length)/12.0}" iyz="0.0"
               izz="${mass*radius*radius/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 虚拟根连杆，解决 KDL 和 Gazebo 对根连杆惯性的限制 -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 机身 ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="2.0" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <!-- ===================== 单腿宏 ===================== -->
  <!--
    prefix: 腿前缀，FL / FR / RL / RR
    hip_x: 髋关节在机身上的 x 位置（前为正）
    hip_y: 髋关节在机身上的 y 位置（左为正）
    hip_axis: 髋关节旋转轴，前腿绕 x，后腿也绕 x，方向可调
    thigh_axis: 大腿关节旋转轴，绕 y
    calf_axis: 小腿关节旋转轴，绕 y
    thigh_dir: 大腿初始朝向，+1 表示向下，-1 表示向上（这里统一向下）
  -->
  <xacro:macro name="leg" params="prefix hip_x hip_y">

    <!-- 髋关节：连接机身与大腿，绕 x 轴摆动 -->
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="${hip_x} ${hip_y} 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-hip_limit}" upper="${hip_limit}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- 大腿连杆 -->
    <link name="${prefix}_thigh_link">
      <visual>
        <origin xyz="0 0 ${-thigh_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${leg_radius}" length="${thigh_length}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-thigh_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${leg_radius}" length="${thigh_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.3" radius="${leg_radius}" length="${thigh_length}"/>
    </link>

    <!-- 大腿关节：连接大腿与小腿，绕 y 轴转动 -->
    <joint name="${prefix}_thigh_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_calf_link"/>
      <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-thigh_limit}" upper="${thigh_limit}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- 小腿连杆 -->
    <link name="${prefix}_calf_link">
      <visual>
        <origin xyz="0 0 ${-calf_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${leg_radius}" length="${calf_length}"/>
        </geometry>
        <material name="red"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-calf_length/2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${leg_radius}" length="${calf_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.2" radius="${leg_radius}" length="${calf_length}"/>
    </link>

    <!-- 小腿关节：连接小腿与足端，绕 y 轴转动 -->
    <joint name="${prefix}_calf_joint" type="revolute">
      <parent link="${prefix}_calf_link"/>
      <child link="${prefix}_foot_link"/>
      <origin xyz="0 0 ${-calf_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-calf_limit}" upper="${calf_limit}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- 足端连杆 -->
    <link name="${prefix}_foot_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
        <material name="red"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
                 iyy="1e-5" iyz="0.0"
                 izz="1e-5"/>
      </inertial>
    </link>

  </xacro:macro>

  <!-- ===================== 四条腿 ===================== -->
  <!-- 髋关节位置：x 前后，y 左右 -->
  <!-- 顺序：FL, FR, RL, RR，与关节编号规范一致 -->

  <xacro:leg prefix="FL" hip_x="${ body_length/2.0 - 0.03}" hip_y="${ body_width/2.0 - 0.02}"/>
  <xacro:leg prefix="FR" hip_x="${ body_length/2.0 - 0.03}" hip_y="${-body_width/2.0 + 0.02}"/>
  <xacro:leg prefix="RL" hip_x="${-body_length/2.0 + 0.03}" hip_y="${ body_width/2.0 - 0.02}"/>
  <xacro:leg prefix="RR" hip_x="${-body_length/2.0 + 0.03}" hip_y="${-body_width/2.0 + 0.02}"/>

<!-- ===================== ros2_control ===================== -->
<ros2_control name="DogSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>

  <joint name="FL_hip_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="FL_thigh_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="FL_calf_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="FR_hip_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="FR_thigh_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="FR_calf_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="RL_hip_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="RL_thigh_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="RL_calf_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="RR_hip_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="RR_thigh_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="RR_calf_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

<!-- ===================== Gazebo 插件 ===================== -->
<gazebo>
  <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
    <parameters>$(find dog_description)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>

<!-- ===================== Gazebo 接触参数 ===================== -->
<gazebo reference="base_link">
  <mu1>0.5</mu1>
  <mu2>0.5</mu2>
  <kp>10000</kp>
  <kd>10</kd>
  <minDepth>0.001</minDepth>
  <maxVel>0.1</maxVel>
</gazebo>

<gazebo reference="FL_thigh_link"><mu1>0.5</mu1><mu2>0.5</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>
<gazebo reference="FL_calf_link"><mu1>0.5</mu1><mu2>0.5</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>
<gazebo reference="FL_foot_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>

<gazebo reference="FR_thigh_link"><mu1>0.5</mu1><mu2>0.5</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>
<gazebo reference="FR_calf_link"><mu1>0.5</mu1><mu2>0.5</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>
<gazebo reference="FR_foot_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>

<gazebo reference="RL_thigh_link"><mu1>0.5</mu1><mu2>0.5</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>
<gazebo reference="RL_calf_link"><mu1>0.5</mu1><mu2>0.5</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>
<gazebo reference="RL_foot_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>

<gazebo reference="RR_thigh_link"><mu1>0.5</mu1><mu2>0.5</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>
<gazebo reference="RR_calf_link"><mu1>0.5</mu1><mu2>0.5</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>
<gazebo reference="RR_foot_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>10000</kp><kd>10</kd><minDepth>0.001</minDepth><maxVel>0.1</maxVel></gazebo>

</robot>